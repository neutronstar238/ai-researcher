# Copy this file to `deploy/docker/.env` or root `.env` for local deployment.
# Do not commit real API keys, passwords, tokens, or private endpoints.

AUTORESEARCH_ENV=local
AUTORESEARCH_PROJECT_ROOT=/workspace
AUTORESEARCH_VAULT_PATH=/workspace/autoresearch-vault
AUTORESEARCH_RUNS_PATH=/workspace/runs
AUTORESEARCH_ARTIFACTS_PATH=/workspace/artifacts

# LLM integrations must stay provider-agnostic. Fill these only when a task needs a real model call.
AUTORESEARCH_LLM_BASE_URL=
AUTORESEARCH_LLM_API_KEY=
AUTORESEARCH_LLM_MODEL_NAME=

# Optional database profile. The MVP still works without this service.
POSTGRES_DB=autoresearch
POSTGRES_USER=autoresearch
POSTGRES_PASSWORD=autoresearch-dev-password
