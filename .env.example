# AI-Researcher 环境变量示例（spec §20.3）
# 复制为 .env 后填写真实值；.env 不得提交到版本库。

# --- 基础 ---
APP_ENV=development
APP_BASE_URL=http://localhost:8080
API_PORT=8000
WEB_PORT=8080
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080

# --- PostgreSQL ---
POSTGRES_USER=airesearcher
POSTGRES_PASSWORD=airesearcher
POSTGRES_DB=airesearcher
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://airesearcher:airesearcher@localhost:5432/airesearcher

# --- Redis ---
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# --- 认证 ---
JWT_SIGNING_KEY=dev-insecure-change-me
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7

# --- MinIO 对象存储 ---
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_ASSETS=assets

# --- Neo4j 图数据库 ---
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=ai-researcher

# --- Milvus 向量库 ---
MILVUS_PORT=19530
MILVUS_GRPC_PORT=9091
MILVUS_URI=http://localhost:19530

# --- 可选外部 Provider（未配置时平台显示"未配置"）---
LLM_PROVIDER=
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
EMBEDDING_PROVIDER=
EMBEDDING_MODEL=
OCR_PROVIDER=
# --- 文献源（未配置时各自降级：polite pool / 匿名低配额）---
LITERATURE_SEMANTIC_SCHOLAR_API_KEY=
LITERATURE_PUBMED_API_KEY=
LITERATURE_OPENALEX_API_KEY=
LITERATURE_CROSSREF_API_KEY=
LITERATURE_ANYRESEARCH_API_KEY=
LITERATURE_MAILTO=research@airesearcher.local
EXPERIMENT_RUNNER_ENDPOINT=
OTEL_EXPORTER_OTLP_ENDPOINT=
