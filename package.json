{
  "name": "ai-researcher-local",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "bin": {
    "airesearcher": "./bin/airesearcher.mjs"
  },
  "scripts": {
    "setup": "node ./bin/airesearcher.mjs setup",
    "serve": "node ./bin/airesearcher.mjs serve --permission-mode approve-dangerous --push-inspiration",
    "autopilot": "node ./bin/airesearcher.mjs autopilot",
    "monitor": "node ./bin/airesearcher.mjs monitor",
    "doctor": "node ./bin/airesearcher.mjs doctor",
    "agent-team:inspect": "node ./bin/airesearcher.mjs agents profile inspect-set .airesearcher/agents/ccfb-team.yaml --materialize-skills --require-complete",
    "channel:test": "node ./bin/airesearcher.mjs channels test",
    "readiness": "node ./bin/airesearcher.mjs readiness",
    "prelaunch": "node ./bin/airesearcher.mjs readiness --push-inspiration --require-channel-config --require-channel-sent --require-agent-team",
    "test": "python -m pytest tests/smoke tests/unit",
    "dev": "npm --prefix frontend run dev --",
    "frontend:build": "npm --prefix frontend run build",
    "frontend:test": "npm --prefix frontend run test",
    "frontend:e2e": "npm --prefix frontend run e2e"
  },
  "engines": {
    "node": ">=20"
  }
}
